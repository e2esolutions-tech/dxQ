# dxq-cert host-scan — periodic filesystem cert inventory.
#
# One-shot unit; paired with dxq-cert-host-scan.timer for
# scheduled execution. Walks the standard cert paths
# (/etc/ssl, /etc/pki, /etc/letsencrypt/live, …) and POSTs
# one event per discovered cert.
#
# Operator config:
#   Environment=DXQ_CERT_COLLECTOR=https://dxq.internal:8090/v1/events
#
# Install:
#   install -m 0644 dxq-cert-host-scan.service /etc/systemd/system/
#   install -m 0644 dxq-cert-host-scan.timer   /etc/systemd/system/
#   install -m 0755 dxq-cert                   /usr/local/bin/
#   systemctl daemon-reload
#   systemctl enable --now dxq-cert-host-scan.timer

[Unit]
Description=dxQ host-filesystem cert inventory scan
After=network-online.target dxq-server.service

[Service]
Type=oneshot
User=dxq
Group=dxq
Environment=RUST_LOG=info,dxq_cert=info

# Read access to the cert paths only — no write needed.
# The scanner walks system cert directories; dxq user
# needs read access (cert dirs are usually world-readable
# on Linux, exception: /etc/letsencrypt/live which needs
# the operator to ACL or run as root via the override).
ExecStart=/usr/local/bin/dxq-cert host-scan \
    --collector ${DXQ_CERT_COLLECTOR}

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
