# sezar-cert host-scan — periodic filesystem cert inventory.
#
# One-shot unit; paired with sezar-cert-host-scan.timer for
# scheduled execution. Walks the standard cert paths
# (/etc/ssl, /etc/pki, /etc/letsencrypt/live, …) and POSTs
# one event per discovered cert.
#
# Operator config:
#   Environment=SEZAR_CERT_COLLECTOR=https://sezar.internal:8090/v1/events
#
# Install:
#   install -m 0644 sezar-cert-host-scan.service /etc/systemd/system/
#   install -m 0644 sezar-cert-host-scan.timer   /etc/systemd/system/
#   install -m 0755 sezar-cert                   /usr/local/bin/
#   systemctl daemon-reload
#   systemctl enable --now sezar-cert-host-scan.timer

[Unit]
Description=Sezar host-filesystem cert inventory scan
After=network-online.target sezar-server.service

[Service]
Type=oneshot
User=sezar
Group=sezar
Environment=RUST_LOG=info,sezar_cert=info

# Read access to the cert paths only — no write needed.
# The scanner walks system cert directories; sezar user
# needs read access (cert dirs are usually world-readable
# on Linux, exception: /etc/letsencrypt/live which needs
# the operator to ACL or run as root via the override).
ExecStart=/usr/local/bin/sezar-cert host-scan \
    --collector ${SEZAR_CERT_COLLECTOR}

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
