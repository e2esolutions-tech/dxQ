# Periodic host cert scan — daily at 03:17 with a 30-min
# jitter to spread load across a fleet.

[Unit]
Description=Daily Sezar host-filesystem cert inventory scan

[Timer]
OnCalendar=03:17
RandomizedDelaySec=30min
Persistent=true
Unit=sezar-cert-host-scan.service

[Install]
WantedBy=timers.target
