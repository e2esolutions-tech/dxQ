# sezar-net — Phase 2.2 libpcap live observation agent.
#
# Captures TLS handshakes off a host network interface and
# POSTs the resulting `crypto_inventory_event` records to a
# collector URL. Spools to disk when the collector is
# unreachable (SEZ-6's outage-buffering path).
#
# Requires CAP_NET_RAW for the libpcap path. The sezar
# system user gets it ambient; no other elevated caps.
#
# Operator config (must override before enabling):
#   Environment=SEZAR_NET_IFACE=eth0
#   Environment=SEZAR_NET_COLLECTOR=https://sezar.internal:8090/v1/events
#   Environment=SEZAR_NET_SPOOL=/var/lib/sezar-net/spool
#
# Install:
#   install -m 0644 sezar-net-live.service /etc/systemd/system/
#   install -m 0755 sezar-net /usr/local/bin/
#   install -d -m 0750 -o sezar -g sezar /var/lib/sezar-net /var/lib/sezar-net/spool
#   systemctl daemon-reload
#   systemctl enable --now sezar-net-live

[Unit]
Description=Sezar network observation agent (libpcap live, Phase 2.2)
After=network-online.target sezar-server.service
Wants=network-online.target

[Service]
Type=simple
User=sezar
Group=sezar
WorkingDirectory=/var/lib/sezar-net
Environment=RUST_LOG=info,sezar_net=info

ExecStart=/usr/local/bin/sezar-net live \
    --iface ${SEZAR_NET_IFACE} \
    --collector ${SEZAR_NET_COLLECTOR} \
    --spool-dir ${SEZAR_NET_SPOOL}

Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=10

NoNewPrivileges=true
# CAP_NET_RAW for libpcap; everything else dropped.
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/sezar-net

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
